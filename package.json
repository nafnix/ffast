{
  "name": "ffast",
  "version": "1.0.0",
  "description": "Self-hosted file sharing with direct downloads",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start --hostname 0.0.0.0",
    "release": "bumpp --git-check --commit \"chore: release v{version}\" --tag \"v{version}\" --push",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.22.0"
}
